<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Workspace>
<!--
  A show: two scenes on one track, back to back.

  "Rojo" holds the Barra's red channel at full for 800 ms; "Verde" holds its
  green for the 800 ms after that. Short on purpose, because the test plays the
  show and reads the wire: at 400 ms red has to be up and green down, at 1200 ms
  the other way round, and after 1600 ms both have to be gone.

  That is the only honest way to check a timeline. Everything about it can look
  right in the model and be wrong in time.

  The track is bound to "Rojo" as its scene. A track's scene is not the same
  thing as what is placed on it: the sequences on a track are that scene's
  values over time, and a track bound to nothing carries sequences that address
  nothing.
-->
<Workspace xmlns="http://www.qlcplus.org/Workspace">
 <Creator>
  <Name>OrchidLights</Name>
  <Version>0.1.0 GIT</Version>
  <Author>poio</Author>
 </Creator>
 <Engine>
  <InputOutputMap>
   <BeatGenerator BeatType="Internal" BPM="120"/>
   <NetworkServer Type="Native" AutoStart="False" Name="" Password=""/>
   <Universe Name="Universe 1" ID="0"/>
  </InputOutputMap>
  <Fixture>
   <Manufacturer>Martin</Manufacturer>
   <Model>MAC500</Model>
   <Mode>DMX1</Mode>
   <ID>0</ID>
   <Name>Spot</Name>
   <Universe>0</Universe>
   <Address>0</Address>
   <Channels>12</Channels>
  </Fixture>
  <Fixture>
   <Manufacturer>Martin</Manufacturer>
   <Model>MAC500</Model>
   <Mode>DMX1</Mode>
   <ID>1</ID>
   <Name>Spot anidado</Name>
   <Universe>0</Universe>
   <Address>12</Address>
   <Channels>12</Channels>
  </Fixture>
  <Fixture>
   <Manufacturer>Generic</Manufacturer>
   <Model>Generic RGBW</Model>
   <Mode>RGBW</Mode>
   <ID>2</ID>
   <Name>Barra</Name>
   <Universe>0</Universe>
   <Address>100</Address>
   <Channels>4</Channels>
  </Fixture>
  <ChannelsGroup ID="0" Name="Blancos" Value="0">2,0,2,3</ChannelsGroup>
  <ChannelsGroup ID="1" Name="Verde" Value="0">2,1</ChannelsGroup>
  <ChannelsGroup ID="2" Name="Gobos" Value="0">0,4,0,5</ChannelsGroup>
  <Function ID="0" Type="Scene" Name="Playback">
   <Speed FadeIn="0" FadeOut="0" Duration="0"/>
   <FixtureVal ID="0">1,255</FixtureVal>
  </Function>
  <Function ID="1" Type="Scene" Name="Rojo">
   <Speed FadeIn="0" FadeOut="0" Duration="0"/>
   <FixtureVal ID="2">0,255</FixtureVal>
  </Function>
  <Function ID="2" Type="Scene" Name="Verde">
   <Speed FadeIn="0" FadeOut="0" Duration="0"/>
   <FixtureVal ID="2">1,255</FixtureVal>
  </Function>
  <Function ID="3" Type="Show" Name="Pase">
   <TimeDivision Type="Time" BPM="120"/>
   <Track ID="0" Name="Luces" SceneID="1" isMute="0">
    <ShowFunction ID="1" StartTime="0" Duration="800"/>
    <ShowFunction ID="2" StartTime="800" Duration="800"/>
   </Track>
  </Function>
 </Engine>
 <VirtualConsole>
  <Frame Caption="Consola" ID="0">
   <WindowState Visible="True" X="0" Y="0" Width="1920" Height="1080"/>
   <Slider Caption="Master" ID="1" WidgetStyle="Slider" InvertedAppearance="false">
    <WindowState Visible="True" X="10" Y="10" Width="60" Height="200"/>
    <SliderMode ValueDisplayStyle="Exact">Submaster</SliderMode>
    <Level LowLimit="0" HighLimit="255" Value="255"/>
   </Slider>
   <Slider Caption="Spot" ID="2" WidgetStyle="Slider" InvertedAppearance="false">
    <WindowState Visible="True" X="80" Y="10" Width="60" Height="200"/>
    <SliderMode ValueDisplayStyle="Exact">Level</SliderMode>
    <Level LowLimit="0" HighLimit="255" Value="0">
     <Channel Fixture="0">1</Channel>
     <Channel Fixture="0">2</Channel>
    </Level>
   </Slider>
   <Button Caption="Escena" ID="10">
    <WindowState Visible="True" X="80" Y="220" Width="100" Height="50"/>
    <Function ID="0"/>
    <Action>Toggle</Action>
   </Button>
   <XYPad Caption="Cabeza" ID="3">
    <WindowState Visible="True" X="150" Y="10" Width="200" Height="200"/>
    <Fixture ID="0" Head="0">
     <Axis ID="X" LowLimit="0" HighLimit="1" Reverse="False"/>
     <Axis ID="Y" LowLimit="0" HighLimit="1" Reverse="False"/>
    </Fixture>
    <Pan Position="0"/>
    <Tilt Position="0"/>
   </XYPad>
   <Frame Caption="Anidado" ID="4">
    <WindowState Visible="True" X="360" Y="10" Width="300" Height="200"/>
    <Slider Caption="Sub anidado" ID="5" WidgetStyle="Slider" InvertedAppearance="false">
     <WindowState Visible="True" X="370" Y="20" Width="60" Height="180"/>
     <SliderMode ValueDisplayStyle="Exact">Submaster</SliderMode>
     <Level LowLimit="0" HighLimit="255" Value="255"/>
    </Slider>
    <Slider Caption="Spot anidado" ID="6" WidgetStyle="Slider" InvertedAppearance="false">
     <WindowState Visible="True" X="440" Y="20" Width="60" Height="180"/>
     <SliderMode ValueDisplayStyle="Exact">Level</SliderMode>
     <Level LowLimit="0" HighLimit="255" Value="0">
      <Channel Fixture="1">1</Channel>
     </Level>
    </Slider>
   </Frame>
   <Frame Caption="Sin nada que escalar" ID="7">
    <WindowState Visible="True" X="700" Y="10" Width="300" Height="200"/>
    <Slider Caption="Sub vacio" ID="8" WidgetStyle="Slider" InvertedAppearance="false">
     <WindowState Visible="True" X="710" Y="20" Width="60" Height="180"/>
     <SliderMode ValueDisplayStyle="Exact">Submaster</SliderMode>
     <Level LowLimit="0" HighLimit="255" Value="255"/>
    </Slider>
    <Label Caption="Solo una etiqueta" ID="9">
     <WindowState Visible="True" X="780" Y="20" Width="200" Height="40"/>
    </Label>
   </Frame>
  </Frame>
 </VirtualConsole>
</Workspace>

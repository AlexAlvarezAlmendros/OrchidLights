<!DOCTYPE Workspace>
<!--
  A project exercising the Virtual Console shapes that real shows here do not
  happen to contain: a playback slider, a countdown clock, a cue list, a Matrix
  widget, and a widget on page 2 of a multipage frame.

  Each one corresponds to a parsing bug this file exists to keep fixed.
-->
<Workspace xmlns="http://www.qlcplus.org/Workspace">
 <Creator><Name>OrchidLights</Name><Version>0.1.0</Version></Creator>
 <Engine>
  <InputOutputMap><Universe Name="Universe 1" ID="0"/></InputOutputMap>
  <Function ID="1" Type="Scene" Name="Escena"/>
  <Function ID="2" Type="Chaser" Name="Chase"/>
 </Engine>
 <VirtualConsole>
  <Frame Caption="Pagina" ID="0">
   <WindowState Visible="True" X="0" Y="0" Width="1920" Height="1080"/>
   <Slider Caption="Playback" ID="10" WidgetStyle="Slider" InvertedAppearance="false">
    <WindowState Visible="True" X="10" Y="10" Width="55" Height="200"/>
    <SliderMode ValueDisplayStyle="Exact">Playback</SliderMode>
    <Playback><Function>1</Function></Playback>
   </Slider>
   <Clock Caption="Cuenta" ID="11" Type="Countdown" Hours="1" Minutes="2" Seconds="3">
    <WindowState Visible="True" X="100" Y="10" Width="150" Height="50"/>
   </Clock>
   <CueList Caption="Cues" ID="12">
    <WindowState Visible="True" X="300" Y="10" Width="300" Height="200"/>
    <Chaser>2</Chaser>
   </CueList>
   <Matrix Caption="Matriz" ID="13">
    <WindowState Visible="True" X="650" Y="10" Width="200" Height="200"/>
   </Matrix>
   <Button Caption="Pagina 2" ID="14" Page="2">
    <WindowState Visible="True" X="10" Y="300" Width="100" Height="50"/>
    <Function ID="1"/>
   </Button>
  </Frame>
 </VirtualConsole>
</Workspace>
